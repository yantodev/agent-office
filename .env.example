# Salin menjadi .env lalu ganti dengan token acak yang panjang.
AGENT_OFFICE_WEB_TOKEN=replace-with-a-long-random-token
AGENT_OFFICE_WEB_HOST=127.0.0.1
AGENT_OFFICE_WEB_PORT=8787
AGENT_OFFICE_WEB_DATA=.agent-office-web
AGENT_OFFICE_WEB_STATIC_DIR=dist/web

# Optional 9router gateway for agent CLI sessions.
# Configure providers and copy the API key from the 9router dashboard first.
AGENT_OFFICE_9ROUTER_ENABLED=0
AGENT_OFFICE_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
AGENT_OFFICE_9ROUTER_API_KEY=
AGENT_OFFICE_9ROUTER_MODEL=
